{
  "skillName": "policy_query",
  "description": "查询用户保单信息，并按固定格式返回",
  "version": "1.0.0",
  "triggers": [
    "查询保单",
    "我的保险",
    "保单信息",
    "保险查询",
    "有哪些保险",
    "保险状态"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "userId": {
        "type": "string",
        "description": "用户ID",
        "required": true
      },
      "policyNo": {
        "type": "string",
        "description": "保单号（可选，不填则返回所有保单）",
        "required": false
      },
      "status": {
        "type": "string",
        "description": "保单状态筛选：active/expired/all",
        "required": false,
        "default": "active"
      }
    },
    "required": ["userId"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "查询是否成功"
      },
      "policyList": {
        "type": "array",
        "description": "保单列表",
        "items": {
          "type": "object",
          "properties": {
            "policyId": {
              "type": "string",
              "description": "保单号"
            },
            "policyName": {
              "type": "string",
              "description": "产品名称"
            },
            "status": {
              "type": "string",
              "description": "保单状态"
            },
            "coverage": {
              "type": "string",
              "description": "保障额度"
            },
            "premium": {
              "type": "string",
              "description": "年缴保费"
            },
            "effectiveDate": {
              "type": "string",
              "description": "生效日期"
            },
            "expiryDate": {
              "type": "string",
              "description": "到期日期"
            },
            "insuranceCompany": {
              "type": "string",
              "description": "保险公司"
            }
          }
        }
      },
      "totalCount": {
        "type": "integer",
        "description": "保单总数"
      },
      "message": {
        "type": "string",
        "description": "提示信息"
      }
    }
  },
  "sensitiveDataConfig": {
    "desensitizationRules": {
      "policyId": {
        "pattern": "(.{2}).*(.{2})",
        "replacement": "$1****$2",
        "description": "保单号脱敏：保留前2位和后2位"
      },
      "idCardNo": {
        "pattern": "(.{6}).*(.{4})",
        "replacement": "$1********$2",
        "description": "身份证号脱敏：保留前6位和后4位"
      },
      "phone": {
        "pattern": "(.{3}).*(.{4})",
        "replacement": "$1****$2",
        "description": "手机号脱敏：保留前3位和后4位"
      },
      "bankAccount": {
        "pattern": "(.{4}).*(.{4})",
        "replacement": "$1****$2",
        "description": "银行账号脱敏：保留前4位和后4位"
      }
    }
  },
  "responseFormat": {
    "template": "json",
    "example": {
      "success": true,
      "policyList": [
        {
          "policyId": "POL****01",
          "policyName": "健康医疗保险",
          "status": "生效中",
          "coverage": "500,000.00",
          "premium": "3,650.00",
          "effectiveDate": "2023-11-02",
          "expiryDate": "2024-11-02",
          "insuranceCompany": "平安保险"
        }
      ],
      "totalCount": 1,
      "message": "查询成功"
    }
  },
  "errorHandling": {
    "userNotFound": {
      "code": "USER_NOT_FOUND",
      "message": "未找到该用户的保单信息"
    },
    "noActivePolicy": {
      "code": "NO_ACTIVE_POLICY",
      "message": "该用户暂无有效保单"
    },
    "systemError": {
      "code": "SYSTEM_ERROR",
      "message": "系统繁忙，请稍后再试"
    }
  }
}
